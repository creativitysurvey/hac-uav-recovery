# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Experiment outputs (regenerated by running the scripts; not committed)
# code/results/ (selective tracking below)
*.pt
*.csv
!paper/**/*.csv
multiseed_log.txt
*_log.txt

# LaTeX build artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# OS / editor cruft
.DS_Store
.vscode/
.idea/
*.swp

# conda / venv
.conda/
venv/
env/

# Allow aggregated multi-seed summary CSV tables to be tracked
!code/results/
code/results/*
!code/results/summary_*.csv
